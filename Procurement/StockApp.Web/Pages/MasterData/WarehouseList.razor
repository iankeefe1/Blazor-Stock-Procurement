@using StockApp.Shared.Dtos
@using StockApp.Web.Components.Filters
@using StockApp.Web.Dialogs
@page "/master/gudang"

<PageTitle>Master Gudang</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Master Gudang</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Daftar gudang tempat barang disimpan.
</MudText>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
        @error
        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                   Class="ml-2" OnClick="OnFilterChanged">Coba lagi</MudButton>
    </MudAlert>
}

<MudPaper Outlined="true" Elevation="0" Class="pa-2">
    <MudTable T="WarehouseDto"
              @ref="table"
              ServerData="LoadServerData"
              Loading="loading"
              LoadingProgressColor="Color.Primary"
              Hover="true"
              Dense="true"
              Elevation="0"
              RowsPerPage="10">
        <ToolBarContent>
            <div class="d-flex align-center flex-wrap" style="gap: 6px;">
                @foreach (var f in ActiveFilters)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                             OnClose="@(() => ClearFilter(f.State))">@f.Text</MudChip>
                }
                @if (AnyFilter)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearAll">Hapus semua filter</MudButton>
                }
            </div>
            <MudSpacer />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-4">
                @(AnyFilter ? $"{totalCount} gudang cocok" : $"{totalCount} gudang")
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => OpenDialogAsync(null))">Tambah gudang</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><ColumnFilter Title="Kode" State="fCode" OnChanged="OnFilterChanged" /></MudTh>
            <MudTh><ColumnFilter Title="Nama gudang" State="fName" OnChanged="OnFilterChanged" /></MudTh>
            <MudTh><ColumnFilter Title="Alamat" State="fAddress" OnChanged="OnFilterChanged" /></MudTh>
            <MudTh><ColumnFilter Title="Status" State="fActive" TrueLabel="Aktif" FalseLabel="Nonaktif" OnChanged="OnFilterChanged" /></MudTh>
            <MudTh Style="width: 110px; text-align: right;">Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Kode">@context.Code</MudTd>
            <MudTd DataLabel="Nama gudang">@context.Name</MudTd>
            <MudTd DataLabel="Alamat">@(string.IsNullOrWhiteSpace(context.Address) ? "-" : context.Address)</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Aktif" : "Nonaktif")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Aksi" Style="text-align: right; white-space: nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               title="Ubah"
                               OnClick="@(() => OpenDialogAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               title="Nonaktifkan"
                               Disabled="@(!context.IsActive)"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                @(loading ? "" : AnyFilter ? "Tidak ada gudang yang cocok dengan filter." : "Belum ada data gudang.")
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>