@namespace StockApp.Web.Dialogs
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Ubah gudang" : "Tambah gudang")</MudText>
    </TitleContent>

    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@error</MudAlert>
        }

        <MudTextField @bind-Value="code"
                      Label="Kode"
                      MaxLength="20"
                      Required="true"
                      Error="@(codeError is not null)"
                      ErrorText="@codeError"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3"
                      OnKeyDown="OnKeyDown" />

        <MudTextField @bind-Value="name"
                      Label="Nama gudang"
                      MaxLength="100"
                      Required="true"
                      Error="@(nameError is not null)"
                      ErrorText="@nameError"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3"
                      OnKeyDown="OnKeyDown" />

        <MudTextField @bind-Value="address"
                      Label="Alamat"
                      MaxLength="300"
                      Lines="3"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-2" />

        @if (IsEdit)
        {
            <MudSwitch @bind-Value="isActive"
                       Color="Color.Success"
                       Label="@(isActive ? "Aktif" : "Nonaktif")" />
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="saving">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="saving">
            @(saving ? "Menyimpan..." : "Simpan")
        </MudButton>
    </DialogActions>
</MudDialog>